    "trip.delete_confirm_message_with_bookings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur Reise löschen“ belässt die Buchungen unter Offene Buchungen. „Reise und Buchungen löschen“ entfernt die enthaltenen Buchungen dauerhaft. Anbieter-Buchungen können beim nächsten Sync wieder erscheinen."
