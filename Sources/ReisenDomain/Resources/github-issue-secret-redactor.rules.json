{
  "markdownCodeFenceMinLength": 3,
  "rules": [
    { "pattern": "(?i)(Authorization:\\s*Bearer\\s+)\\S+", "template": "$1[redacted]" },
    { "pattern": "(?i)(Bearer\\s+)(?:ghp_|github_pat_)[A-Za-z0-9_]+", "template": "$1[redacted]" },
    { "pattern": "github_pat_[A-Za-z0-9_]+", "template": "[redacted]" },
    { "pattern": "ghp_[A-Za-z0-9]+", "template": "[redacted]" },
    { "pattern": "(?i)(Cookie:\\s*)\\S.*", "template": "$1[redacted]" },
    { "pattern": "(?i)([?&](?:code|token|session|password)=)[^&\\s]+", "template": "$1[redacted]" },
    { "pattern": "(?i)(\\\"(?:access_token|refresh_token|id_token|api[_-]?key|token|session|password|authorization|sentinel)\\\"\\s*:\\s*\\\")[^\\\"]*(\\\")", "template": "$1[redacted]$2" },
    { "pattern": "(?i)\\b(sen_t|tvs|tvl|tvo|clientSessionId|tv-clientsessionid)\\s*[:=]\\s*[^;\\s&]+", "template": "$1=[redacted]" },
    { "pattern": "(?i)(\\\"(?:confirmationCode|confirmation_code|bookingNumber|booking_number|pnr)\\\"\\s*:\\s*\\\")[^\\\"]*(\\\")", "template": "$1[redacted]$2" },
    { "pattern": "(?i)\\b((?:buchungs(?:nummer|nr|code)|vorgangsnummer|confirmation(?:\\s*code)?|confirmationcode|booking\\s*(?:ref(?:erence)?|number|code)|pnr|record\\s*locator)\\s*[:=]?\\s*)[A-Z0-9-]{4,}", "template": "$1[redacted]" },
    { "pattern": "(?i)(\\\"(?:givenName|familyName|secondFamilyName|firstName|lastName|fullName|displayName|birthDate|email|phoneNumber|phone|mobile|address|street|postalCode|zipCode|passportNumber|passport|iban)\\\"\\s*:\\s*\\\")[^\\\"]*(\\\")", "template": "$1[redacted]$2" },
    { "pattern": "(?i)([?&](?:email|firstName|lastName|givenName|familyName|phone|mobile|address|street|passenger)=)[^&\\s]+", "template": "$1[redacted]" },
    { "pattern": "(?i)\\b((?:vorname|nachname|familienname|given\\s*name|family\\s*name|first\\s*name|last\\s*name)\\s*[:=]\\s*)[^\\s&?,;]+", "template": "$1[redacted]" },
    { "pattern": "(?i)\\b((?:adresse|address)\\s*[:=]\\s*)[^\\n]+", "template": "$1[redacted]" },
    { "pattern": "(?i)\\b((?:telefon|tel\\.?|phone|handy|mobilfunk(?:nummer)?|mobile)\\s*[:=]\\s*)[+\\d][\\d\\s/().-]{5,}", "template": "$1[redacted]" },
    { "pattern": "(?i)\\b((?:geburtsdatum|birth(?:\\s*date)?|date of birth|dob)\\s*[:=]\\s*)[\\d./-]{6,10}", "template": "$1[redacted]" },
    { "pattern": "(?i)\\b((?:passnummer|reisepass|passport(?:\\s*no(?:umber)?)?)\\s*[:=]\\s*)\\S+", "template": "$1[redacted]" },
    { "pattern": "(?i)[A-Z0-9._%+\\-]+@[A-Z0-9.\\-]+\\.[A-Z]{2,}", "template": "[redacted]" },
    { "pattern": "\\+\\d{1,3}(?:[\\s./-]?\\d{2,4}){2,4}", "template": "[redacted]" },
    { "pattern": "\\b[A-Z]{2}\\d{2}(?:[ ]?[A-Z0-9]){10,30}\\b", "template": "[redacted]" },
    { "pattern": "(?i)\\b[^\\W\\d_]+(?:straße|strasse|str\\.|weg|platz|allee)\\s+\\d+[a-z]?", "template": "[redacted]" },
    { "pattern": "(?i)(/(?:Users|home)/)[^/\\s]+", "template": "$1[redacted]" }
  ]
}
